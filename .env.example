# Core platform (required)
MONGODB_URI=
MONGODB_DB=builderfind
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
APP_ORIGIN=http://localhost:3000

# Vercel Blob (required for uploads)
BLOB_READ_WRITE_TOKEN=

# Transactional email (required for password reset and email alerts)
RESEND_API_KEY=
EMAIL_FROM=BuilderFind <notifications@example.com>

# SMS notifications (optional until enabled per user)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Operations
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
CRON_SECRET=
NEXT_PUBLIC_REALTIME_ENABLED=true
